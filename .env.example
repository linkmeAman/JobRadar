TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_personal_chat_id

# Optional UI API protection. The browser prompts for this token when needed.
JOB_RADAR_UI_TOKEN=
JOB_RADAR_CONFIG_PATH=config.yaml
JOB_RADAR_DATABASE_PATH=data/jobs.db
JOB_RADAR_LOCK_PATH=data/job-radar.lock

# Docker defaults; change only when using different mounted filenames/cadence.
JOB_RADAR_RESUME_PATHS=/app/resumes/Aman_Singh.pdf,/app/resumes/Aman_Singh_CV.pdf
JOB_RADAR_INTERVAL_SECONDS=1800
JOB_RADAR_BACKUP_INTERVAL_SECONDS=86400
JOB_RADAR_BACKUP_RETENTION_DAYS=14
